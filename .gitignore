# AI Assistant Configuration
# CLAUDE.md and AGENTS.md are tracked (project instructions for contributors
# and agents). Local-only overrides stay ignored.
.claude/
.agent/
.qoder/
CLAUDE.local.md
AGENTS.override.md
skills-lock.json

# Distribution
/dist/
/packages/*/dist/
/.turbo/
/packages/*/.turbo/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Node
node_modules/
npm-debug.log*

# Prelude reference trees preserve archive modes that Git cannot round-trip.
# They are deterministic materializations of the pinned Artifact archives.
/.prelude/*/repos/

# IDE
.idea/
.vscode/
.obsidian/
*.swp
*.swo
*~
