# AI Assistant Configuration
# AGENTS.md is tracked as project instructions for contributors and agents.
# Tool-specific and local-only assistant overrides stay ignored.
.claude/
.agent/
.qoder/
CLAUDE.local.md
AGENTS.override.md
skills-lock.json
/.docwarden/NOTES.md

# Distribution
/dist/
/packages/*/dist/
/.turbo/
/packages/*/.turbo/

# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Node
node_modules/
npm-debug.log*

# Prelude reference trees preserve archive modes that Git cannot round-trip.
# They are deterministic materializations of the pinned Artifact archives.
/.prelude/*/repos/

# IDE
.idea/
.vscode/
.obsidian/
*.swp
*.swo
*~
