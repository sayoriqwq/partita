{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": [
        "bin/partita.ts"
      ],
      "project": [
        "bin/**/*.ts",
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "mkfifo"
  ],
  "ignoreDependencies": [
    "@effect/tsgo",
    "@sayoriqwq/prelude",
    "@sayoriqwq/psychogram",
    "turbo"
  ]
}
